---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Contact — OG Toolser"
  description="Report a bug, suggest a tool, or flag an error in a calculation on OG Toolser."
  canonicalPath="/contact/"
>
  <div class="container static-page">
    <Breadcrumbs crumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]} />
    <h1>Contact</h1>
    <p>
      Spotted a bug, have a tool suggestion, or found an error in a calculation? We'd like to
      hear about it — email <a href="mailto:hello@ogtoolser.com">hello@ogtoolser.com</a>.
    </p>
    <p>
      When reporting a calculation error, please include the tool name and the exact input you
      used — it helps us reproduce and fix the issue quickly. See our
      <a href="/about/">correction policy</a> for how reports are handled.
    </p>
  </div>
</BaseLayout>

<style>
  .static-page {
    max-width: var(--tool-width);
    padding: var(--space-8) 0 var(--space-10);
  }
</style>
